// CampusConnect ER diagram (DBML), matching db/migrations/001-004.
// Paste into https://dbdiagram.io to render the diagram.
// Docs: https://dbml.dbdiagram.io/docs

Table User {
  user_id integer [pk]
  username varchar [not null, unique]
  email varchar(254) [not null, unique]
  password_hash text [null]
  email_verified_at timestamp [null]
  role varchar [not null, default: 'student']
  created_at timestamp [not null]
  credit_balance integer [not null]
  credit_last_reset date [not null]
  is_banned boolean [not null]
  is_account_deleted boolean [not null, default: false]
  can_add_resources boolean [not null, default: true]
  email_notifications_on boolean [not null]
  profile_image_id integer [null, unique]
  failed_login_attempts integer [not null, default: 0]
  locked_until timestamptz [null]
}

Table EmailVerificationToken {
  token_id integer [pk]
  user_id integer [not null]
  token_hash bytea [not null, unique]
  created_at timestamp [not null]
  used_at timestamp [null]
}

Table Building {
  building_id integer [primary key]
  building_name varchar [not null, unique]
  address varchar [not null, unique]
  latitude decimal(9,6) [not null]
  longitude decimal(9,6) [not null]
  google_place_id varchar [null, unique]
}

Table Resource {
  resource_id integer [primary key]
  owner_id integer [not null]
  building_id integer [not null]
  category_id integer [not null]
  name varchar [not null]
  description text [not null]
  location_description text [not null]
  max_reservation_time interval
  required_credits integer [not null]
  min_user_review_score decimal(3,2) [null]
  capacity integer [not null]
  created_at timestamp [not null]
  resource_image_id integer [null, unique]
}

Table ResourceCategory {
  category_id integer [primary key]
  category_name varchar [not null, unique]
  description text [not null, unique]
}

Table ResourceFeature {
  feature_id integer [primary key]
  resource_id integer [not null]
  feature_name varchar [not null]
  description text [not null]
}

Table ResourceAvailability {
  availability_id integer [primary key]
  resource_id integer [not null]
  start_time timestamp [not null]
  end_time timestamp [not null]
  repeats_until timestamp
  repeats_offset interval
}

Table MaintenancePeriod {
  maintenance_id integer [primary key]
  resource_id integer [not null]
  start_time timestamp [not null]
  end_time timestamp [not null]
  reason text [not null]
}

Table Reservation {
  reservation_id integer [primary key]
  user_id integer [not null]
  resource_id integer [not null]
  start_time timestamp [not null]
  end_time timestamp [not null]
  status varchar [not null]
  created_at timestamp [not null]
}

Table CreditTransaction {
  transaction_id integer [primary key]
  user_id integer [not null]
  amount integer [not null]
  transaction_type varchar [not null]
  created_at timestamp [not null]
}

Table Notification {
  notification_id integer [primary key]
  user_id integer [not null]
  reservation_id integer [null]
  message text [not null]
  notification_type varchar [not null]
  created_at timestamp [not null]
  scheduled_for timestamp [null]
  email_status varchar [null, note: "pending, sent, skipped, or failed"]
  email_workflow_id varchar(100) [null, unique]
  email_sent_at timestamp [null]
  email_error text [null]
  read_at timestamp [null, note: "NULL means unread"]
}

Table ReservationReview {
  reservation_id integer [primary key]
  reviewer_user_id integer [not null]
  reviewee_user_id integer [not null]
  rating integer [not null]
  reason text
  created_at timestamp [not null]
  is_anonymous_review boolean [not null]
}

Table ResourceReview {
  review_id integer [primary key]
  resource_id integer [not null]
  reviewer_user_id integer [not null]
  rating integer [not null]
  reason text
  created_at timestamp [not null]
  is_anonymous_review boolean [not null]
}

Table Session {
  session_id integer [primary key]
  user_id integer [not null]
  token_hash bytea [not null, unique]
  created_at timestamp [not null]
  expires_at timestamp [not null]
}

Table ImageMetadata {
  image_id integer [primary key]
  object_key varchar [unique, not null]
  content_type varchar [not null]
  size bigint [not null]
  width int [not null]
  height int [not null]
  alt_text varchar
  status varchar [not null]
  uploaded_at timestamp [not null]
  filename varchar [not null]
}

// Relationships

Ref: Resource.category_id > ResourceCategory.category_id [delete: cascade]
Ref: Resource.building_id > Building.building_id [delete: cascade]
Ref: Resource.owner_id > User.user_id [delete: cascade]

Ref: ResourceFeature.resource_id > Resource.resource_id

Ref: ResourceAvailability.resource_id > Resource.resource_id

Ref: MaintenancePeriod.resource_id > Resource.resource_id

Ref: Reservation.user_id > User.user_id
Ref: Reservation.resource_id > Resource.resource_id

Ref: CreditTransaction.user_id > User.user_id

Ref: Notification.user_id > User.user_id [delete: cascade]
Ref: Notification.reservation_id > Reservation.reservation_id [delete: cascade]

Ref: EmailVerificationToken.user_id > User.user_id [delete: cascade]

Ref: ReservationReview.reviewee_user_id > User.user_id
Ref: ReservationReview.reviewer_user_id > User.user_id

Ref: Reservation.reservation_id -? ReservationReview.reservation_id

Ref: ResourceReview.resource_id > Resource.resource_id
Ref: ResourceReview.reviewer_user_id > User.user_id

Ref: Session.user_id > User.user_id

Ref: User.profile_image_id -? ImageMetadata.image_id [delete: set null]
Ref: Resource.resource_image_id -? ImageMetadata.image_id
